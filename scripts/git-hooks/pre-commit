#!/usr/bin/env bash
# Secret guard (blocks commits that would leak local credentials) and
# auto-version (bumps the patch number on every commit — see step 3).
# Installed into .git/hooks/pre-commit (this tracked copy is the source —
# re-install after a fresh clone with:  scripts/install_git_hooks.sh).
#
# Layered with tests/test_secret_hygiene.py, which fails the suite if a
# secret ever becomes tracked or the ignore rules regress.
set -euo pipefail

# 1) Nothing under instance/ may ever be committed — that's where the
#    Gemini API key and the Flask secret live. Catches `git add -f` too.
staged_instance=$(git diff --cached --name-only -- 'instance/*')
if [ -n "$staged_instance" ]; then
  echo "COMMIT BLOCKED: files under instance/ hold local secrets:" >&2
  echo "$staged_instance" >&2
  echo "Unstage with: git restore --staged instance/" >&2
  exit 1
fi

# 2) No staged ADDED line may contain something shaped like an API key
#    (Google keys are AIza + 35 chars; sk-... covers other providers).
if git diff --cached -U0 | grep -E '^\+' \
     | grep -Eq 'AIza[0-9A-Za-z_-]{35}|sk-[A-Za-z0-9_-]{32,}'; then
  echo "COMMIT BLOCKED: staged changes contain something that looks like" >&2
  echo "an API key. Remove the secret from the change, then commit again." >&2
  exit 1
fi

# 3) Auto-version: every commit bumps the PATCH number in version.py and
#    pyproject.toml (1.3.0 -> 1.3.1) and stages both, so each commit carries
#    its own version number. Skipped when either file is already staged —
#    that's a deliberate hand edit (minor/major bump) and must stand — or
#    when SP_NO_BUMP=1 is set (e.g. a --amend that shouldn't bump twice).
if [ -z "${SP_NO_BUMP:-}" ] \
   && ! git diff --cached --name-only | grep -qE '^(version\.py|pyproject\.toml)$'; then
  root="$(git rev-parse --show-toplevel)"
  cur=$(sed -nE 's/^__version__ = "([0-9]+\.[0-9]+\.[0-9]+)"[[:space:]]*$/\1/p' "$root/version.py")
  if [ -n "$cur" ]; then
    major=${cur%%.*}; rest=${cur#*.}; minor=${rest%%.*}; patch=${rest#*.}
    new="$major.$minor.$((patch + 1))"
    for f in version.py pyproject.toml; do
      # write-then-move: GNU and BSD sed disagree on -i, git bash has GNU
      sed -E "s/^(__version__ = |version = )\"$cur\"/\1\"$new\"/" "$root/$f" > "$root/$f.tmp" \
        && mv "$root/$f.tmp" "$root/$f"
    done
    git add "$root/version.py" "$root/pyproject.toml"
    echo "version $cur -> $new (auto-bump; SP_NO_BUMP=1 skips it)"
  fi
fi
